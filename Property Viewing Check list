/* Toast */
.toast{position:fixed;left:50%;bottom:24px;z-index:95;transform:translate(-50%,calc(100% + 60px));visibility:hidden;transition:transform .6s var(--ease),visibility 0s .6s!important;background:var(--brand-panel-2);border:1px solid var(--brand-line);border-left:4px solid var(--brand-yellow);border-radius:14px;padding:13px 18px;font-size:14.5px;box-shadow:0 20px 50px -20px rgba(0,0,0,.9);transition:transform .6s var(--ease);max-width:calc(100% - 32px)}
.toast.is-on{transform:translate(-50%,0)}

