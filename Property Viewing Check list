@media (max-width:900px){.about_card{grid-template-columns:1fr}.about_photo{width:104px;height:104px}}

/* FAQ */
.faq_list{display:flex;flex-direction:column;border-top:1px solid var(--brand-line);max-width:860px}
.faq_item{border-bottom:1px solid var(--brand-line)}
.faq_question{width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;background:none;border:0;text-align:left;padding:24px 0;font-size:clamp(17px,1.7vw,20px);font-weight:600;cursor:pointer;transition:color .3s}
