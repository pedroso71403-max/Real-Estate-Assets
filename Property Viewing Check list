    pill.style.transform = "translateX(" + tab.offsetLeft + "px)";
  }
  function showStage(id, focus){
    if(id === current || switching) return;
    var tab = document.getElementById("tab-" + id), next = document.getElementById("pane-" + id),
        prev = current && document.getElementById("pane-" + current);
    menu.querySelectorAll(".tab_link").forEach(function(t){ var on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", on); t.tabIndex = on ? 0 : -1; });
    bars.querySelectorAll(".stage_bar").forEach(function(b){ b.classList.toggle("is-active", b.dataset.goto === id); });
    movePill(tab);
    var ml = menu.scrollLeft, tl = tab.offsetLeft, tr = tl + tab.offsetWidth;
    if(tl < ml) menu.scrollTo({left: tl - 6, behavior: "smooth"});
    else if(tr > ml + menu.clientWidth) menu.scrollTo({left: tr - menu.clientWidth + 6, behavior: "smooth"});
    current = id;
    function enter(){
      next.hidden = false; void next.offsetWidth; next.classList.add("is-in");
      if(focus) tab.focus({preventScroll:true});
    }
    if(prev && !reduce){
      switching = true; prev.classList.remove("is-in");
      setTimeout(function(){ prev.hidden = true; switching = false; enter(); }, 260);
    } else { if(prev){ prev.hidden = true; prev.classList.remove("is-in"); } enter(); }
  }
  menu.addEventListener("click", function(e){ var t = e.target.closest(".tab_link"); if(t) showStage(t.dataset.stage); });
  menu.addEventListener("keydown", function(e){
    if(e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    var ids = CHECKLIST.map(function(s){ return s.id; }), i = ids.indexOf(current);
    i = (i + (e.key === "ArrowRight" ? 1 : -1) + ids.length) % ids.length; showStage(ids[i], true);
  });
  document.addEventListener("click", function(e){
    var g = e.target.closest("[data-goto]"); if(!g) return;
    showStage(g.dataset.goto);
    if(g.classList.contains("tab_next")) scrollToEl(document.querySelector(".checklist_main"), -100);
  });
  addEventListener("resize", function(){ var t = document.getElementById("tab-" + current); if(t) movePill(t); });

  var ringBar = document.querySelector(".progress_ring .bar"), CIRC = 251.33,
      doneEl = document.querySelector(".js-done"), msgEl = document.querySelector(".progress_msg");
  function msgFor(n){
    if(n === TOTAL) return "All " + TOTAL + " done. That's a properly assessed viewing.";
    var firstOpen = null;
    CHECKLIST.some(function(st){ var open = st.items.some(function(_, i){ return !state[st.id + "-" + i]; }); if(open){ firstOpen = st; return true; } });
    if(n === 0) return "Start with the night before: run your numbers.";
    return { before:"Good start. Finish your prep before you set off.", during:"In the property now. Work room by room.",
             questions:"Checks done. Time for the questions.", contracts:"Nearly there. Get your paperwork lined up." }[firstOpen.id];
  }
  function update(){
    var n = 0;
    CHECKLIST.forEach(function(st){
      var c = 0; st.items.forEach(function(_, i){ if(state[st.id + "-" + i]) c++; });
      n += c;
      document.querySelector('[data-count="' + st.id + '"]').textContent = c + "/" + st.items.length;
      document.querySelector('[data-fill="' + st.id + '"]').style.width = (c / st.items.length * 100) + "%";
    });
    doneEl.textContent = n;
    ringBar.style.strokeDashoffset = CIRC * (1 - n / TOTAL);
    msgEl.textContent = msgFor(n); msgEl.classList.toggle("is-done", n === TOTAL);
    return n;
  }
  panes.querySelectorAll(".checklist_item").forEach(function(b){
    if(state[b.dataset.id]){ b.classList.add("is-checked"); b.setAttribute("aria-pressed","true"); }
    b.addEventListener("click", function(){
      var on = !b.classList.contains("is-checked");
      b.classList.toggle("is-checked", on); b.setAttribute("aria-pressed", on);
      if(on){ b.classList.remove("just-checked"); void b.offsetWidth; b.classList.add("just-checked"); }
      if(on) state[b.dataset.id] = 1; else delete state[b.dataset.id];
      save();
      var before = Object.keys(state).length, n = update();
      if(on && n === TOTAL) toast("All " + TOTAL + " checks done. Nice work.");
    });
  });
  document.querySelector(".js-reset").addEventListener("click", function(){
    state = {}; save();
    panes.querySelectorAll(".checklist_item").forEach(function(b){ b.classList.remove("is-checked","just-checked"); b.setAttribute("aria-pressed","false"); });
    update(); showStage(CHECKLIST[0].id); toast("Ticks cleared. Ready for the next viewing.");
  });
  update();
  var startStage = CHECKLIST[0].id;
  CHECKLIST.some(function(st){ var open = st.items.some(function(_, i){ return !state[st.id + "-" + i]; }); if(open){ startStage = st.id; return true; } });
  requestAnimationFrame(function(){ showStage(startStage); });

  /* Download offline checklist */
  function download(){
    var tpl = document.getElementById("offline-template").textContent.trim();
    var data = CHECKLIST.map(function(s){ return {id:s.id, label:s.label, items:s.items}; });
    var html = tpl.replace(/<\\\/script>/g, "</" + "script>")
                  .replace("__DATA__", JSON.stringify(data).replace(/</g, "\\u003c"))
                  .split("__TRUSTPILOT__").join(TRUSTPILOT_URL)
                  .replace("__AVATAR_SRC__", logoSmall.src);
    var blob = new Blob([html], {type:"text/html;charset=utf-8"});
    var url = URL.createObjectURL(blob), a = document.createElement("a");
    a.href = url; a.download = "Freeman_Viewing_Checklist.html";
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ URL.revokeObjectURL(url); }, 4000);
    toast("Downloaded. Open it from your Downloads or Files app.");
  }
  document.querySelectorAll(".js-download").forEach(function(b){ b.addEventListener("click", download); });

  /* Trustpilot stars */
  var stars = [].slice.call(document.querySelectorAll(".star")), hint = document.querySelector(".review_hint"), picked = 0;
  var hints = ["", "Thanks. Tell Freeman what would make it better.", "Thanks. What could be clearer?", "Thanks. What would make it a 5?", "Glad it helped. Share what worked for you.", "Brilliant. Tell others what helped most."];
  function light(n){ stars.forEach(function(s, i){ s.classList.toggle("is-lit", i < n); s.style.transitionDelay = (i * 45) + "ms"; }); }
  stars.forEach(function(s){
    var n = +s.dataset.star;
    s.addEventListener("mouseenter", function(){ light(n); });
    s.addEventListener("focus", function(){ light(n); });
    s.addEventListener("click", function(){ picked = n; light(n); hint.textContent = hints[n] + " Opening Trustpilot…"; setTimeout(function(){ window.open(TRUSTPILOT_URL, "_blank", "noopener"); }, 450); });
  });
  document.querySelector(".stars").addEventListener("mouseleave", function(){ light(picked); });

  /* Quote word highlight on scroll */
  var quote = document.querySelector(".js-quote");
  (function(){
    var out = "";
    quote.childNodes.forEach(function(n){
      var accent = n.nodeType === 1;
      n.textContent.split(/(\s+)/).forEach(function(p){
        if(!p) return; if(/^\s+$/.test(p)){ out += " "; return; }
        out += '<span class="w' + (accent ? " is-accent" : "") + '">' + p + "</span>";
      });
    });
    quote.innerHTML = out;
  })();
  var qWords = [].slice.call(quote.querySelectorAll(".w"));

  /* Count-up stats */
  var counters = [].slice.call(document.querySelectorAll(".js-counter"));
  if("IntersectionObserver" in window){
    var cio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(!e.isIntersecting) return; cio.unobserve(e.target);
        var el = e.target, to = +el.dataset.to, start = null, dur = reduce ? 1 : 1600;
        (function step(t){ if(!start) start = t; var p = Math.min((t - start) / dur, 1);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 4))); if(p < 1) requestAnimationFrame(step); })(performance.now());
      });
    }, {threshold:.6});
    counters.forEach(function(c){ cio.observe(c); });
  } else counters.forEach(function(c){ c.textContent = c.dataset.to; });

  /* Step card spotlight */
  document.querySelectorAll(".step_card").forEach(function(c){
    c.addEventListener("pointermove", function(e){ var r = c.getBoundingClientRect();
      c.style.setProperty("--mx", (e.clientX - r.left) + "px"); c.style.setProperty("--my", (e.clientY - r.top) + "px"); });
  });

  /* FAQ */
  document.querySelectorAll(".faq_item").forEach(function(item){
    var q = item.querySelector(".faq_question");
    q.addEventListener("click", function(){
      var open = !item.classList.contains("is-open");
      document.querySelectorAll(".faq_item.is-open").forEach(function(o){ o.classList.remove("is-open"); o.querySelector(".faq_question").setAttribute("aria-expanded","false"); });
      if(open){ item.classList.add("is-open"); q.setAttribute("aria-expanded","true"); }
    });
  });

  /* Smooth scroll (Lenis, with native fallback) */
  var lenis = null;
  function scrollToEl(el, offset){
    if(!el) return;
    if(lenis) lenis.scrollTo(el, {offset: offset || -80, duration: 1.4});
    else window.scrollTo({top: el.getBoundingClientRect().top + scrollY + (offset || -80), behavior: reduce ? "auto" : "smooth"});
  }
  document.addEventListener("click", function(e){
    var a = e.target.closest("a[data-scroll]"); if(!a) return;
    var id = a.getAttribute("href"); if(!id || id.charAt(0) !== "#") return;
    e.preventDefault(); scrollToEl(id === "#top" ? document.body : document.querySelector(id), id === "#top" ? 0 : -80);
  });
  function initLenis(){
    if(reduce || !window.Lenis || lenis) return;
    lenis = new window.Lenis({duration:1.15, easing:function(t){ return Math.min(1, 1.001 - Math.pow(2, -10 * t)); }, smoothWheel:true});
    function raf(t){ lenis.raf(t); requestAnimationFrame(raf); } requestAnimationFrame(raf);
  }
  window.addEventListener("load", initLenis);

  /* Scroll-linked effects */
  var nav = document.querySelector(".navbar_component"), bar = document.querySelector(".scroll_progress"),
      heroImg = document.querySelector(".hero_logo_wrap"), mbar = document.querySelector(".mobile_bar"),
      lastY = 0, ticking = false;
  function onScroll(){
    var y = window.scrollY, max = doc.scrollHeight - innerHeight;
    nav.classList.toggle("is-scrolled", y > 20);
    nav.classList.toggle("is-hidden", y > 400 && y > lastY + 4);
    if(y < lastY - 4) nav.classList.remove("is-hidden");
    lastY = y;
    bar.style.transform = "scaleX(" + (max > 0 ? y / max : 0) + ")";
    if(!reduce && y < innerHeight * 1.2) heroImg.style.translate = "0 " + (y * 0.08) + "px";
    mbar.classList.toggle("is-visible", y > innerHeight * .6);
    var r = quote.getBoundingClientRect();
    var p = Math.min(1, Math.max(0, (innerHeight * .85 - r.top) / (innerHeight * .55)));
    var on = Math.round(p * qWords.length);
    qWords.forEach(function(w, i){ w.classList.toggle("is-on", i < on); });
    ticking = false;
  }
  addEventListener("scroll", function(){ if(!ticking){ requestAnimationFrame(onScroll); ticking = true; } }, {passive:true});
  onScroll();

  /* Logo 3D tilt + sheen (desktop only) */
  var tiltEl = document.querySelector(".js-tilt");
  if(finePointer && !reduce && tiltEl){
    var wrap = tiltEl.parentElement, tiltT;
    wrap.addEventListener("pointermove", function(e){
      var r = wrap.getBoundingClientRect(), px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
      tiltEl.classList.add("is-tilting");
      tiltEl.style.transform = "rotateX(" + ((0.5 - py) * 14).toFixed(2) + "deg) rotateY(" + ((px - 0.5) * 16).toFixed(2) + "deg) scale(1.02)";
      tiltEl.style.setProperty("--sx", (px * 100) + "%"); tiltEl.style.setProperty("--sy", (py * 100) + "%");
      clearTimeout(tiltT);
    });
    wrap.addEventListener("pointerleave", function(){
      tiltEl.classList.remove("is-tilting"); tiltEl.style.transform = "";
      tiltEl.style.removeProperty("--sx"); tiltEl.style.removeProperty("--sy");
    });
  }

  /* Cursor glow + ring (desktop only) */
  if(finePointer && !reduce){
    var glow = document.querySelector(".cursor_glow"), ring = document.querySelector(".cursor_ring");
    var mx = innerWidth / 2, my = innerHeight / 2, gx = mx, gy = my, rx = mx, ry = my, sc = 1, active = false;
    addEventListener("pointermove", function(e){
      if(e.pointerType !== "mouse") return;
      mx = e.clientX; my = e.clientY;
      if(!active){ active = true; gx = rx = mx; gy = ry = my; document.body.classList.add("has-cursor"); }
    }, {passive:true});
    document.addEventListener("pointerleave", function(){ document.body.classList.remove("has-cursor"); active = false; });
    document.addEventListener("pointerover", function(e){
      ring.classList.toggle("is-hover", !!e.target.closest("a,button,input,textarea,.star"));
    });
    addEventListener("pointerdown", function(){ ring.classList.add("is-down"); });
    addEventListener("pointerup", function(){ ring.classList.remove("is-down"); });
    (function loop(){
      gx += (mx - gx) * .08; gy += (my - gy) * .08;
      rx += (mx - rx) * .24; ry += (my - ry) * .24;
      glow.style.transform = "translate3d(" + gx + "px," + gy + "px,0)";
      var s = ring.classList.contains("is-down") ? .8 : (ring.classList.contains("is-hover") ? 1.7 : 1);
      sc += (s - sc) * .18;
      ring.style.transform = "translate3d(" + rx + "px," + ry + "px,0) scale(" + sc.toFixed(3) + ")";
      requestAnimationFrame(loop);
    })();
    ring.style.transition = "opacity .5s, border-color .3s";
  }

  requestAnimationFrame(function(){ document.body.classList.add("is-loaded"); });
})();
</script>
</body>
