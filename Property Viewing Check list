/* Download */
.download_card{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,4vw,64px);align-items:center;background:var(--brand-panel);border:1px solid var(--brand-line);border-radius:30px;padding:clamp(26px,4.5vw,60px);position:relative;overflow:hidden}
.download_card::before{content:"";position:absolute;width:520px;height:520px;right:-160px;top:-200px;border-radius:50%;background:radial-gradient(circle,rgba(var(--brand-yellow-rgb),.14),transparent 65%);pointer-events:none}
