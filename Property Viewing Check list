.faq_answer > div{overflow:hidden}
.faq_answer p{padding-bottom:24px;color:var(--text-muted);max-width:680px;opacity:0;transform:translateY(-6px);transition:opacity .5s,transform .7s var(--ease)}
.faq_item.is-open .faq_answer p{opacity:1;transform:none;transition-delay:.12s}

/* Footer */
.footer_component{border-top:1px solid var(--brand-line);padding:34px 0;font-size:14px;color:var(--text-muted)}
